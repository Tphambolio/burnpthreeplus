# Environment Configuration Example
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development

# Backend API
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://burnp3:burnp3_dev_password@db:5432/burnp3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DATA=burnp3-data
S3_BUCKET_RESULTS=burnp3-results
S3_REGION=us-east-1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://frontend:3000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Logging
LOG_LEVEL=INFO

# Simulation Settings
DEFAULT_IGNITION_COUNT=1000
DEFAULT_ITERATION_COUNT=1000
MAX_PARALLEL_FIRES=4
